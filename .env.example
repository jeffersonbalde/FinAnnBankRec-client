# Copy this file to .env (local dev) — every API call in the app depends on this
# ONE variable. Never commit the real .env (it's already gitignored).

# Full base URL of the Laravel API, including /api/v1.
#   Local dev (php artisan serve):
VITE_LARAVEL_API=http://localhost:8000/api/v1

# Production build (npm run build): leave this EMPTY instead. The app then calls
# a same-origin relative /api/v1, and the web server (nginx) proxies /api,
# /sanctum and /storage to Laravel — no client .env needed on the server at all.
